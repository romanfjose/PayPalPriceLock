# PayPal Sandbox REST API v2 Credentials (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Channel3 Product Intelligence API (https://trychannel3.com/developers — Promo Code: PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# APIMatic Context Plugin / Codegen Configuration (https://www.apimatic.io)
APIMATIC_API_KEY=

# AI Model Provider (Supports Google Vertex AI / Gemini 3.5+ Flash, OpenAI, or DeepSeek)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Optional AG Studio License Key (Runs on built-in 45-day hackathon trial by default)
AG_STUDIO_LICENSE_KEY=
